{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd api && npm install && npm run db:generate && npm run build"
  },
  "deploy": {
    "preDeployCommand": ["cd api && npm run db:migrate"],
    "startCommand": "cd api && npm run start",
    "restartPolicyType": "ON_FAILURE"
  }
}
