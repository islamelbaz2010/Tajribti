# ============================================================
# TAJRIBTI API — PRODUCTION ENVIRONMENT (Pilot Deployment)
# ============================================================
# Set ALL of these as Railway environment variables.
# Do NOT commit this file with real values.
# ============================================================

# --- Node / Server ---
PORT=3000                     # Railway injects this automatically — do NOT set manually
NODE_ENV=pilot                # 'pilot' enables synchronize:true without dev logging
                              # Change to 'production' only after running migrations

# --- Demo Mode ---
DEMO_MODE=false               # MUST be false for real OTP delivery

# --- CORS ---
# Set this to your Vercel dashboard URL (no trailing slash)
CORS_ORIGIN=https://your-dashboard.vercel.app

# --- Consumer Web URL ---
# Same as CORS_ORIGIN — used to build QR code URLs
CONSUMER_WEB_URL=https://your-dashboard.vercel.app

# --- Database ---
# Railway Postgres: copied from Railway dashboard > Postgres plugin > Connection String
# Format: postgresql://postgres:PASSWORD@HOST:PORT/railway
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_CHAR_HEX_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHAR_HEX_HERE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Admin Secret (required — protects POST /admin/seed and POST /admin/seed/reset) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pass as header in requests: x-admin-secret: <value>
# If not set, both admin endpoints return 401 (fail-safe)
ADMIN_SECRET=GENERATE_32_CHAR_HEX_HERE

# --- Twilio (required for real OTP) ---
# console.twilio.com > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # Must be a Twilio phone number that can send to Egypt (+20)

# --- AI Report (optional — fallback narrative used if omitted) ---
ANTHROPIC_API_KEY=sk-ant-...
# or
OPENAI_API_KEY=sk-...

# --- Demo Seed Config (used only when POST /admin/seed is called) ---
DEMO_BRAND_EMAIL=demo@brand.com
DEMO_BRAND_PASSWORD=Demo1234!
DEMO_BRAND_NAME=Sprite Zero Egypt
DEMO_PRODUCT_NAME=Sprite Zero Sugar
DEMO_CAMPAIGN_NAME=Cairo Consumer Intelligence Pilot
DEMO_LOCATION_NAME=City Stars Mall — Ground Floor Atrium
