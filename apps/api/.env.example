# ============================================================
# TAJRIBTI DEMO API — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Demo Mode — set to true to enable OTP bypass ("0000" always works)
# MUST be true for sales meetings
DEMO_MODE=true

# CORS — Brand Dashboard URL
CORS_ORIGIN=http://localhost:3001

# Consumer Web URL — used to generate QR codes for real (non-demo) campaigns.
# The QR encodes this URL so consumers scan it and the phone camera opens the browser journey.
# Set to your public dashboard URL in production (e.g. https://dashboard.yourdomain.com).
CONSUMER_WEB_URL=http://localhost:3001

# ============================================================
# DATABASE — Supabase or Railway PostgreSQL
# Get from: supabase.com > Project Settings > Database > Connection String
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# ============================================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ============================================================
# JWT — Generate a secure random string for each secret
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# ADMIN SECRET — protects POST /admin/seed and POST /admin/seed/reset
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pass as header: x-admin-secret: <value>
# Required in production. In local demo, scripts/demo.sh sets this automatically.
# ============================================================
ADMIN_SECRET=

# ============================================================
# TWILIO — SMS OTP delivery (not required if DEMO_MODE=true)
# Get from: console.twilio.com
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================================
# AI — OpenAI or Anthropic for report generation
# At least one must be set for AI reports to work
# ============================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================
# BRAND DASHBOARD — Demo credentials (pre-seeded in database)
# ============================================================
DEMO_BRAND_EMAIL=demo@brand.com
DEMO_BRAND_PASSWORD=Demo1234!

# ============================================================
# SEED — Demo campaign configuration
# ============================================================
DEMO_CAMPAIGN_NAME=Cairo Consumer Intelligence Pilot
DEMO_PRODUCT_NAME=Almaza Light
DEMO_BRAND_NAME=Egyptian Beverages Co.
DEMO_LOCATION_NAME=City Stars Mall — Ground Floor Atrium
