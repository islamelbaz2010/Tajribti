// TAJRIBTI Benchmark Edition — Data Model
//
// Derived exclusively from governance/REFERENCE_PRODUCT_BENCHMARK.md.
// Campaign is the central operating object (Benchmark §5). Every entity here
// maps to a Benchmark-named capability node (§4) or an explicitly-cited
// "must preserve" foundation (§10: verified participation / already-
// participated protection, QR lifecycle/date gating, company isolation,
// employee company isolation, report/insight ownership scoping).
//
// No field was added because a previous implementation had it. Where the
// Benchmark names a capability without defining its exact shape, the
// smallest coherent structure was chosen (see BENCHMARK-AMBIGUOUS notes
// inline and in the final report).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TAJRIBTI OPERATIONS (internal actor surface — Benchmark §4 "TAJRIBTI OPERATIONS")
// ---------------------------------------------------------------------------

// FOUNDER INNOVATION (OFD-08, spec docs/TAJRIBTI_FOUNDER_INNOVATION_SPEC_
// 2026-09-20.md §H–L) — NOT Benchmark-required. Two Innovation-layer roles:
// "PLATFORM_ADMIN" (platform administration: company creation, ops-user
// management, audited consumer-PII access) and "OPERATIONS" (campaign
// pipeline/monitoring/issues/change-request review — no consumer-PII lists).
// Migration backfills existing rows to PLATFORM_ADMIN so no current user
// loses capability. Both are Innovation-layer names, not Benchmark truth.
model OpsUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATIONS")
  createdAt    DateTime @default(now())

  issuesOpened            OperationalIssue[]
  studyTypeRequestReviews StudyTypeChangeRequest[]
  questionChangeReviews   QuestionChangeRequest[]
  notificationLaunches    CampaignNotificationRequest[]
}

// ---------------------------------------------------------------------------
// COMPANY (Benchmark §4 "COMPANY" — Company Profile, Employees)
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  createdAt DateTime @default(now())

  employees Employee[]
  products  Product[]
  campaigns Campaign[]
}

// No OWNER/MEMBER (or any other) role tier: Benchmark §4 COMPANY names
// only "Employees" as a capability, with no permission-tier language
// anywhere in the document. A prior pass carried a `role` column here
// and gated employee invitation on it — that is a PRODUCT PERMISSION
// decision (this prompt's own §4 worked example), not a technical
// detail, and it had no Benchmark support. Removed. Every employee of a
// company has equal capability within that company; the only boundary
// Benchmark actually names is company-level "employee company isolation"
// (§10), which is enforced by scoping every query to companyId.
// FOUNDER INNOVATION (OFD-08) — multiple Company roles. "COMPANY_ADMIN" has
// full company capability including employee management and change requests;
// "COMPANY_MEMBER" can author campaigns/products/questions and view reporting
// but cannot manage employees or file requests. Existing rows are backfilled
// to COMPANY_ADMIN by the migration (preserves current capability — the
// removed-role history above is superseded only because the Founder has now
// explicitly authorized multiple company roles as Innovation).
model Employee {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("COMPANY_MEMBER")
  createdAt    DateTime @default(now())

  studyTypeRequests      StudyTypeChangeRequest[]
  questionChangeRequests QuestionChangeRequest[]
  notificationRequests   CampaignNotificationRequest[]

  @@index([companyId])
}

// Benchmark §4 COMPANY "Product / Assets"
model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  imageUrl    String?
  // FOUNDER INNOVATION (OFD-05): structured Price/Pack/Claims metadata.
  // priceRange/packSize are descriptive labels (e.g. "EGP 25-35", "250ml") —
  // a numeric price+currency model was deliberately NOT invented (no
  // currency model or numeric-answer question type exists). claims is a
  // JSON array of claim strings referenced by the CLAIMS_TESTING study
  // template. All optional; a product without them behaves identically.
  priceRange  String?
  packSize    String?
  claims      String?
  createdAt   DateTime @default(now())

  campaigns Campaign[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// CONSUMER (Benchmark §4 "CONSUMER"; §10 "consumer authentication / OTP/JWT flow")
// ---------------------------------------------------------------------------

model Consumer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // FOUNDER INNOVATION (OFD-15A): explicit, reversible, timestamped opt-in to
  // the shared TAJRIBTI panel. Same-company cross-campaign aggregation reads
  // only opted-in consumers (spec §F). Opting out stops future inclusion in
  // panel aggregates; historical participation evidence is unchanged.
  panelOptIn   Boolean   @default(false)
  panelOptInAt DateTime?
  // FOUNDER INNOVATION (OFD-14C): explicit push opt-in + device token holder.
  // No notifications are ever sent to a consumer who has not opted in.
  pushOptIn    Boolean   @default(false)
  pushOptInAt  DateTime?
  pushToken    String?

  otpCodes       OtpCode[]
  participations Participation[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id])
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ---------------------------------------------------------------------------
// CAMPAIGN — the core operating object (Benchmark §5)
// ---------------------------------------------------------------------------

// Benchmark §2.4 names the Company chain Configure -> Review/Ready ->
// Launch/Active -> Monitor -> Complete, and §4 OPERATIONS separately
// names the action set "Launch / Pause / Close". Together these two
// passages support the five states below (DRAFT~Configure,
// READY~Review/Ready, ACTIVE~Launch/Active, PAUSED from the named Pause
// action, COMPLETED~Complete) — exact naming is still an engineering
// choice (§2.4 explicitly defers it: "must use TAJRIBTI's existing
// lifecycle model rather than introducing a competing state machine"),
// but the existence of each state is Benchmark-traceable. What is NOT
// traceable, and therefore intentionally absent, is a "resume" action:
// naming Pause does not itself authorize Resume, Restart, Extend, Clone,
// or Rollback (Benchmark's own worked caution). A PAUSED campaign can
// only be closed. Likewise no "revert to draft" exists on the Company
// side — no reverse transition is named in the §2.4 chain.
// Valid values: "DRAFT" | "READY" | "ACTIVE" | "PAUSED" | "COMPLETED"
// (String, not a native enum — SQLite/Prisma limitation; enforced in code).

model Campaign {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name      String
  // Benchmark §2.4/§3: "Campaign has a clear purpose, not only product/date
  // fields". Kept as free text — no taxonomy of objective types is defined
  // by the Benchmark, so none is invented (BENCHMARK-AMBIGUOUS: objective
  // taxonomy).
  objective String

  // Audience / Eligibility (Benchmark §3 "Audience/qualification").
  // Minimal demographic filter fields; screening beyond these is expressed
  // as ELIGIBILITY-stage Questions below.
  audienceAgeMin Int?
  audienceAgeMax Int?
  audienceGender String? // "ANY" | "MALE" | "FEMALE"
  audienceCity   String?

  // FOUNDER-APPROVED STRATEGIC DIFFERENTIATION (see
  // governance/FOUNDER_DECISION_STRATEGIC_DIFFERENTIATION.md) — NOT
  // Benchmark-required. Optional tag identifying which study-template
  // catalog entry (api/src/lib/studyTemplates.ts) this campaign was
  // configured from, if any. Purely descriptive metadata: nothing in
  // measurement.ts or report.ts branches on this value or changes its
  // methodology based on it. A campaign with no studyType behaves
  // identically to the pre-existing Benchmark-only product.
  //
  // GOVERNANCE (forensic audit 2026-09-15, Decision 1): this field may
  // only be changed directly (via PATCH) while the campaign has zero
  // Question rows. Once ≥1 question exists, a change must go through
  // StudyTypeChangeRequest below (Warn + Operations approval) — see
  // company.ts assertStudyTypeChangeAllowed(). This model file does not
  // enforce that rule itself (SQLite/Prisma cannot express "field X is
  // immutable once relation Y is non-empty" declaratively); it is
  // enforced in the route layer, same as every other business rule in
  // this schema.
  studyType String?

  startDate DateTime
  endDate   DateTime
  status    String   @default("DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions               Question[]
  qrSources               QrSource[]
  participations          Participation[]
  issues                  OperationalIssue[]
  studyTypeChangeRequests StudyTypeChangeRequest[]
  media                   CampaignMedia[]
  questionChangeRequests  QuestionChangeRequest[]
  notificationRequests    CampaignNotificationRequest[]

  @@index([companyId])
}

// FOUNDER-APPROVED — forensic audit 2026-09-15, Decision 1 ("Study-Type
// change = WARN + OPERATIONS REVIEW/APPROVAL"). NOT Benchmark-required in
// its own right, but implements Benchmark §4 OPERATIONS "Readiness" /
// operational-control posture for the one campaign-identity field the
// Founder decided needs governance once real survey content exists on a
// campaign. Purely additive: a campaign with no request rows behaves
// identically to the pre-existing product.
//
// Deliberately NOT a generic workflow/approval engine (per the
// implementation brief's own §4/§17 prohibition) — this table only ever
// represents "change this one campaign's studyType tag from A to B",
// nothing else is ever requested through it.
// status: "PENDING" | "APPROVED" | "REJECTED"
model StudyTypeChangeRequest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  // Snapshot of campaign.studyType at request time — not re-derived later,
  // so the request record stays a truthful historical statement of what
  // was asked for even if the campaign's studyType is changed again by a
  // later, independent request.
  currentStudyType   String?
  requestedStudyType String?

  requestedById String
  requestedBy   Employee @relation(fields: [requestedById], references: [id])

  status String @default("PENDING")

  reviewedById    String?
  reviewedBy      OpsUser?  @relation(fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
}

// Benchmark §4 "Journey / Survey"; §2.3 screening/claim/trial/feedback stages
// stage: "ELIGIBILITY" | "POST_TRIAL"
// type: "SINGLE_CHOICE" | "MULTI_CHOICE" | "TEXT" | "RATING_1_5" |
//       "PURCHASE_INTENT_1_5" (Benchmark §3: purchase intent is a
//       first-class signal)
model Question {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  stage      String
  type       String
  text       String
  // JSON array of {id, label} for choice types; null otherwise.
  options    String?
  order      Int
  required   Boolean  @default(true)

  answers Answer[]

  @@index([campaignId])
}

// Benchmark §3 "QR/source attribution"; §10 "QR lifecycle/date gating"
model QrSource {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  code       String   @unique
  label      String
  activeFrom DateTime
  activeTo   DateTime
  createdAt  DateTime @default(now())

  participations Participation[]

  @@index([campaignId])
}

// Benchmark §10 "Already-Participated protection" (unique campaign+consumer);
// §3 "Verified participation"; funnel stages from §11 desired product shape.
// status: "ENTERED" | "ELIGIBLE" | "INELIGIBLE" | "TRIAL_REDEEMED" |
//         "SURVEY_COMPLETE" | "DROPPED"
model Participation {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  consumerId String
  consumer   Consumer  @relation(fields: [consumerId], references: [id])
  qrSourceId String?
  qrSource   QrSource? @relation(fields: [qrSourceId], references: [id])

  status String @default("ENTERED")

  // Demographic snapshot captured at eligibility time (Benchmark §7 report
  // requirement "demographics"). Stored per-participation, not on the
  // global Consumer record, since the Benchmark does not define a
  // persistent consumer profile model (BENCHMARK-AMBIGUOUS).
  ageAtEntry    Int?
  genderAtEntry String?
  cityAtEntry   String?

  enteredAt         DateTime  @default(now())
  eligibilityAt     DateTime?
  trialRedeemedAt   DateTime?
  surveyCompletedAt DateTime?

  answers Answer[]

  @@unique([campaignId, consumerId]) // Already-Participated protection
  @@index([campaignId])
  @@index([qrSourceId])
}

model Answer {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  questionId      String
  question        Question      @relation(fields: [questionId], references: [id])

  valueText    String?
  valueNumber  Float?
  valueOptions String? // JSON array of selected option ids for choice types

  createdAt DateTime @default(now())

  @@unique([participationId, questionId])
  @@index([questionId])
}

// Benchmark §4 OPERATIONS "Operational Issues" — minimal issue log.
// No automated detection algorithm is invented (Benchmark §9 explicitly
// excludes "automated fraud detection"; nothing in the Benchmark
// specifies an issue-detection methodology, so none is fabricated here —
// issues are opened/resolved manually by TAJRIBTI Operations).
// status: "OPEN" | "RESOLVED"
model OperationalIssue {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  openedById  String
  openedBy    OpsUser   @relation(fields: [openedById], references: [id])
  type        String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([campaignId])
}

// ===========================================================================
// FOUNDER INNOVATION LAYER — everything below is OFD-authorized additive
// surface (docs/TAJRIBTI_FOUNDER_INNOVATION_SPEC_2026-09-20.md), NOT
// Benchmark-required. No existing model above was weakened or reshaped.
// ===========================================================================

// OFD-12 — Campaign media/gallery. URL-referenced assets only (no binary
// storage infra exists this pass — an upload/storage provider is a separate
// future decision). kind: "PRODUCT_IMAGE" | "PACKAGING_IMAGE" |
// "CAMPAIGN_MEDIA" | "CREATIVE".
// FOUNDER INNOVATION (D-5, 2026-09-20): HOSTED media approved. `source`
// distinguishes URL-referenced assets (unchanged path) from bucket-hosted
// uploads. HOSTED rows store `storageKey` (campaign-scoped object key);
// `url` holds no external link for HOSTED rows — read URLs are signed at
// request time (private bucket, per media spec). status: "PENDING"
// (upload-init issued, not yet confirmed) | "READY" (object confirmed).
model CampaignMedia {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  kind        String
  url         String
  caption     String?
  source      String   @default("URL")
  status      String   @default("READY")
  storageKey  String?
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

// OFD-19 — Question change governance. On a lifecycle-locked campaign
// (ACTIVE/PAUSED/COMPLETED) a company cannot mutate questions directly; it
// files a request that TAJRIBTI Operations performs. action: "EDIT"|"DELETE".
// payload: for EDIT, the new question field values (text/options/required/
// order — type/stage changes are rejected; delete+create is the honest path).
// status: "PENDING" | "APPLIED" | "REJECTED"
model QuestionChangeRequest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  questionId String?
  action     String
  payload    String?
  reason     String?

  requestedById String
  requestedBy   Employee @relation(fields: [requestedById], references: [id])

  status String @default("PENDING")

  performedById String?
  performedBy   OpsUser?  @relation(fields: [performedById], references: [id])
  performedAt   DateTime?
  reviewNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents QuestionAuditEvent[]

  @@index([campaignId])
  @@index([status])
}

// OFD-19 — every question modification is traceable: what changed, previous
// value, new value, who requested, who performed, when, campaign, and the
// campaign's lifecycle state at the moment of the change. Written for direct
// company edits (DRAFT/READY) AND ops-applied changes alike.
// actorKind: "employee" | "ops"
model QuestionAuditEvent {
  id             String   @id @default(cuid())
  campaignId     String
  questionId     String?
  action         String // "CREATE" | "EDIT" | "DELETE"
  prevValue      String?  // JSON snapshot
  newValue       String?  // JSON snapshot
  actorKind      String
  actorId        String
  actorName      String
  lifecycleState String
  requestId      String?
  request        QuestionChangeRequest? @relation(fields: [requestId], references: [id])
  createdAt      DateTime @default(now())

  @@index([campaignId])
}

// DORMANT (forensic pass 2026-09-20): the Founder decision of 2026-09-20
// states consumers receive NO push notifications. All routes/UI for this
// model were removed; the table is kept because dropping it would be a
// destructive migration with no product need. Do not reintroduce a
// notification surface without a new explicit Founder decision.
// status: "PENDING" | "LAUNCHED" | "REJECTED"
model CampaignNotificationRequest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  body       String

  requestedById String
  requestedBy   Employee @relation(fields: [requestedById], references: [id])

  status String @default("PENDING")

  launchedById   String?
  launchedBy     OpsUser? @relation(fields: [launchedById], references: [id])
  launchedAt     DateTime?
  eligibleCount  Int?
  deliveryStatus String?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
}

// OFD-08 — access/PII auditability. Written whenever a privileged or
// PII-bearing action occurs (company creation, ops-user creation,
// participants-PII list access, panel access, question-change apply,
// notification launch). actorKind: "ops" | "employee" | "consumer"
model AccessAuditEvent {
  id         String   @id @default(cuid())
  actorKind  String
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([actorKind, actorId])
  @@index([createdAt])
}
