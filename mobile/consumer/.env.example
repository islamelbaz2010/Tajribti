# Flutter does not load .env files at runtime.
# API_BASE is a build-time constant set via --dart-define.
# This file is documentation only.
#
# Usage:
#   flutter run --dart-define=API_BASE=http://<host>:4000/api
#
# Defaults (when --dart-define is not passed):
#   Android emulator: http://10.0.2.2:4000/api
#
# Common values:
#   Android emulator : http://10.0.2.2:4000/api
#   iOS simulator    : http://127.0.0.1:4000/api
#   Physical device  : http://192.168.1.<x>:4000/api

API_BASE=http://10.0.2.2:4000/api
